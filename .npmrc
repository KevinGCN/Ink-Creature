# El arbol de dependencias de este proyecto tiene peers opcionales
# (@napi-rs/wasm-runtime -> @emnapi/core, @emnapi/runtime) que npm 11 no
# sabe colocar: falla con "Cannot read properties of null (reading 'children')"
# y deja el lockfile fuera de sync ("Missing: @emnapi/core from lock file").
#
# Con legacy-peer-deps npm los omite y tanto `npm install` como `npm ci`
# funcionan. Este archivo tambien lo lee Netlify durante el build.
legacy-peer-deps=true
